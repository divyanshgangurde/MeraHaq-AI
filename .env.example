# MeraHaq AI — environment template (copy to .env, never commit .env)

# --- Required for a working (non-demo) deployment ---

# MySQL-compatible database (local MariaDB/MySQL, or TiDB Cloud for hosting).
# Example local: mysql://merahaq:merahaq@localhost:3306/merahaq
DATABASE_URL=

# Session cookie signing secret. Generate one: openssl rand -hex 32
JWT_SECRET=

# LLM provider — OpenAI-compatible API. Default base is OpenRouter.
# OpenRouter setup: sign up at https://openrouter.ai, create a key under
# Keys, add a small credit balance (or pick a free model), paste it here.
LLM_API_KEY=
# Optional overrides (defaults shown):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-5-mini
# LLM_MAX_TOKENS=4096
# EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Optional ---

# Local-disk storage root for ingested PDFs/text (default: ./data/storage)
# On Vercel the filesystem is ephemeral: set STORAGE_DIR=/tmp/storage there.
# Corpus answers read chunks from the database, so Q&A works regardless;
# only /storage/* downloads of the source PDFs need persistent storage
# (a future object-storage swap) to survive on serverless hosting.
# STORAGE_DIR=

# Admin bootstrap: the openId that receives the admin role on sign-in.
# OWNER_OPEN_ID=

# --- Legacy / only needed if you keep Manus OAuth login ---
# Public Q&A does not need these. Admin ingestion currently signs in via
# Manus OAuth; replacing it with a self-hosted login is a later step.
# OAUTH_SERVER_URL=
# VITE_APP_ID=
